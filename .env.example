# ═══════════════════════════════════════════════════════════════
#  GENLEA — Environment Variables
#  Copy to .env and fill in values. DO NOT commit .env to git.
# ═══════════════════════════════════════════════════════════════


# ─── Infrastructure ───────────────────────────────────────────

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=genlea

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

API_PORT=4001
API_HOST=0.0.0.0
API_SECRET=change_me_before_production


# ─── LLM Provider ─────────────────────────────────────────────
#
#   PROVIDER options: google | groq | anthropic | ollama
#
#   ── Google AI Studio (AGENT_LLM_PROVIDER=google) ─────────────
#   gemini-2.0-flash             → fast, free tier           ← default
#   gemini-2.5-flash             → balanced speed + quality
#   gemini-2.5-pro               → best reasoning
#
#   ── Groq (AGENT_LLM_PROVIDER=groq) ───────────────────────────
#   llama-3.1-8b-instant         → 500k TPD, fastest / cheapest
#   llama-3.3-70b-versatile      → 100k TPD, great reasoning
#   openai/gpt-oss-120b          → GPT-4 class, Groq-hosted
#   moonshotai/kimi-k2-instruct  → strong reasoning
#
#   ── Anthropic (AGENT_LLM_PROVIDER=anthropic) ─────────────────
#   claude-haiku-4-5-20251001    → fast + cheap, high-volume
#   claude-sonnet-4-6            → strong balance
#   claude-opus-4-7              → best quality
#
#   ── Ollama / local (AGENT_LLM_PROVIDER=ollama) ───────────────
#   qwen3.5                      → default local model
#   setup: brew install ollama && ollama pull qwen3.5 && ollama serve
#

ENABLE_HOSTED_LLM=true
AGENT_LLM_PROVIDER=google
AGENT_LLM_MODEL=gemini-2.0-flash
# AGENT_LLM_MODEL=gemini-2.5-flash
# AGENT_LLM_MODEL=gemini-2.5-pro
# AGENT_LLM_MODEL=llama-3.1-8b-instant
# AGENT_LLM_MODEL=llama-3.3-70b-versatile
# AGENT_LLM_MODEL=openai/gpt-oss-120b
# AGENT_LLM_MODEL=claude-haiku-4-5-20251001
# AGENT_LLM_MODEL=claude-sonnet-4-6
# AGENT_LLM_MODEL=claude-opus-4-7

GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (only needed when AGENT_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_KEEP_ALIVE=5m


# ─── Discovery & Enrichment APIs ──────────────────────────────

# Explorium — best source: 200M+ company DB, verified contacts
EXPLORIUM_API_KEY=

# Hunter.io — email discovery (25 free/month)
HUNTER_API_KEY=

# GitHub — tech stack extraction (5000 req/hr with token, 60 without)
GITHUB_TOKEN=

# Crunchbase — startup + funding data
CRUNCHBASE_API_KEY=

# Apollo.io — B2B contacts (50 free exports/month)
APOLLO_API_KEY=

# Clearbit — company metadata (Explorium covers the same — only add if you have a key)
CLEARBIT_API_KEY=


# ─── Scrapers requiring login sessions ────────────────────────

LI_SESSION_DIR=sessions/linkedin
LI_USERNAME=
LI_PASSWORD=
LI_MAX_PROFILES_PER_SESSION=80
LI_SESSION_COOLDOWN_HOURS=8

SALESNAV_USERNAME=
SALESNAV_PASSWORD=

ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=


# ─── Proxy ────────────────────────────────────────────────────

PROXY_PROVIDER=brightdata
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_ZONE=residential_rotating
PROXY_LIST_FILE=proxies/proxy-list.txt


# ─── Scraping Behaviour ───────────────────────────────────────

SCRAPE_INTERVAL_HOURS=6
MAX_CONCURRENT_BROWSERS=10
SCRAPE_DELAY_MIN_MS=2000
SCRAPE_DELAY_MAX_MS=8000


# ─── Name Origin Analysis ─────────────────────────────────────
# groq       → uses GROQ_API_KEY, no extra setup
# ethnicolr  → local Python microservice (more accurate)

NAME_ORIGIN_PROVIDER=groq
ETHNICOLR_URL=http://localhost:5050


# ─── Email Verification ───────────────────────────────────────

EMAIL_VERIFY_PROVIDER=mailcheck
MAILCHECK_API_KEY=


# ─── Lead Scoring Thresholds ──────────────────────────────────

INDIAN_RATIO_THRESHOLD=0.60
INDIAN_RATIO_MIN_SAMPLE=5
LEAD_SCORE_HOT_THRESHOLD=65
LEAD_SCORE_WARM_THRESHOLD=50
TARGET_TECH_STACK=nodejs,typescript,python,react,nextjs,nestjs,frontend,backend,fullstack,ai,ml,generative-ai,fastapi


# ─── Logging ──────────────────────────────────────────────────

LOG_LEVEL=info
LOG_PRETTY=true


# ─── Agent Failure Alerts ─────────────────────────────────────
# Leave ALERT_EMAIL_TO empty to disable (failures logged as warn)

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=


# ─── LangSmith Tracing ────────────────────────────────────────
# Uncomment to enable agent observability at smith.langchain.com

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=genlea
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
